{
  "name": "marcapony",
  "version": "0.11.3",
  "description": "Marcapony CLI \u2014 link a project to an app environment and deploy it to Marcapony-hosted infrastructure",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://marcapony.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creafolks/marcapony-devkit.git",
    "directory": "cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "marcapony": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "manifest.schema.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "isomorphic-git": "^1.44.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.2.0"
  }
}
