{
  "build": "bun run build",
  "worker": "dist/worker/index.js",
  "assets": "dist/client",
  "assetsConfig": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibilityDate": "2026-10-01",
  "compatibilityFlags": ["nodejs_compat"],
  "placement": "portal",
  "dataAccess": "customer",
  "permissions": [
    {
      "id": "view-bookings",
      "label": "See my appointments",
      "grants": ["reservations.own.read"]
    },
    {
      "id": "book",
      "label": "Book and cancel appointments",
      "grants": ["reservations.own.create", "reservations.own.cancel"]
    }
  ],
  "portal": { "title": "Appointments" }
}
