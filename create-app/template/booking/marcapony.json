{
  "$schema": "./node_modules/marcapony/manifest.schema.json",
  "manifest": 2,
  "build": "bun run build",
  "server": "dist/server/index.js",
  "public": {
    "dir": "dist/client"
  },
  "routes": {
    "server": ["/api/*"],
    "notFound": "spa"
  },
  "runtime": "2026-10",
  "ignore": ["coverage/", "*.log"],
  "placement": "portal",
  "dataAccess": "customer",
  "permissions": [
    {
      "id": "view-bookings",
      "label": "See my appointments",
      "grants": ["reservations.own.read"]
    },
    {
      "id": "book",
      "label": "Book and cancel appointments",
      "grants": ["reservations.own.create", "reservations.own.cancel"]
    }
  ],
  "portal": {
    "title": "Appointments"
  }
}
