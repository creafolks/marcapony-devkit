{
  "name": "marcapony-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "link": "marcapony app link",
    "deploy": "marcapony app deploy",
    "build": "bun run build:client && bun run build:worker",
    "build:client": "vite build",
    "build:worker": "esbuild src/server/index.ts --bundle --format=esm --platform=neutral --conditions=worker,browser --target=es2022 --outfile=dist/worker/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "marcapony-sdk": "^0.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.0",
    "marcapony": "^0.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
