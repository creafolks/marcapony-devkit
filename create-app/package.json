{
  "name": "create-marcapony-app",
  "version": "0.2.2",
  "description": "Scaffold a Marcapony app \u2014 a Worker backed by the Marcapony API, ready for `marcapony app link` and `marcapony app deploy`",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://marcapony.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creafolks/marcapony-devkit.git",
    "directory": "create-app"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-marcapony-app": "dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "check:templates": "bun run scripts/check-templates.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "typescript": "^5.8.3"
  }
}
