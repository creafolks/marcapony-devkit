{
  "name": "marcapony-devkit",
  "private": true,
  "type": "module",
  "workspaces": [
    "sdk",
    "cli",
    "create-app"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && bun run typecheck && bun run build && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  }
}
